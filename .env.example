# 复制本文件为 .env 并填入真实值
# 注意：.env 已被 .gitignore 排除，绝不上传 GitHub

# Web 服务器端口
WEB_PORT=8088
# 游戏服务器 WebSocket 端口
WS_PORT=31300
WS_PORT_FORMAL=31301

# Admin IPC 端口
ADMIN_IPC_PORT=31303
ADMIN_IPC_PORT_FORMAL=31304

# MD5 加密前缀（用于密码加密）
MD5_PREFIX=请替换

# Session 会话密钥
SESSION_SECRET=请替换

# DES 加密向量（16字节，用于数据加解密）
DESIV=请替换

# Admin IPC 密钥（web.js与游戏进程内部通信认证）
ADMIN_IPC_SECRET=请替换
