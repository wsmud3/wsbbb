# Copy this file to .env and replace every CHANGE_ME value.
# .env is ignored by Git; never commit real secrets.

# Web server and game WebSocket ports
WEB_PORT=8088
WS_PORT=31300
WS_PORT_FORMAL=31301

# Admin IPC ports
ADMIN_IPC_PORT=31303
ADMIN_IPC_PORT_FORMAL=31304

# Password/session encryption settings
MD5_PREFIX=CHANGE_ME
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET
# DESIV must be exactly 16 bytes for aes-128-cbc.
DESIV=0123456789ABCDEF

# Internal admin IPC authentication
ADMIN_IPC_SECRET=CHANGE_ME_ADMIN_IPC_SECRET

# Password recovery remains disabled until a single-use out-of-band provider
# is configured.  Do not enable it for the legacy phone/captcha endpoint.
ACCOUNT_RECOVERY_ENABLED=false

# Optional token for detailed local /health diagnostics (16+ random chars).
HEALTH_TOKEN=CHANGE_ME_HEALTH_TOKEN

# Optional standalone reload credential. If empty, /reload requires an admin session.
API_RELOAD_TOKEN=
# Optional internal role-transfer credential. If empty, the phone lookup helper is disabled.
TRANSROLE_SERVICE_TOKEN=

# Comma-separated explicitly trusted browser/app origins. Same-origin and localhost apps are allowed by default.
CORS_ORIGINS=
# Set true only when the web endpoint is served over HTTPS.
COOKIE_SECURE=false
# Server-side login certificate lifetime (default: 180 days).
SESSION_CERT_TTL_MS=15552000000

# First database creation only; absent/short password leaves the initial admin disabled.
INITIAL_ADMIN_PASSWORD=
# Set only to known reverse-proxy addresses/subnets, e.g. loopback. Never trust arbitrary forwarded IPs.
TRUST_PROXY=
