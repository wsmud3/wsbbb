!data/db.js
!data/sql.js

# ========== 日志 ==========
log/

# ========== 构建产物 ==========
*.apk
www/

# ========== Python ==========
__pycache__/
*.pyc

# ========== 备份与压缩包 ==========
*.tar.gz
*.zip
*.bak

# ========== 个人配置 ==========
.claude/

# ========== 系统 ==========
.DS_Store
