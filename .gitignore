# ========== 依赖 ==========
node_modules/

# ========== 密钥（服务器本地保留，绝不上传） ==========
.env
.env.apk

# ========== 运行期数据（玩家数据库、实例状态） ==========
data/*
# 但 data 下的源码文件要上传
!data/db.js
!data/sql.js

# ========== 日志 ==========
log/

# ========== 构建产物 ==========
*.apk
# 前端生产入口和哈希 bundle 必须随仓库发布，服务器定时 git pull 后可直接提供最新页面。
# 运行 npm run build 会先清理旧的 index-* bundle，再生成当前版本。

# ========== Python ==========
__pycache__/
*.pyc

# ========== 备份与压缩包 ==========
*.tar.gz
*.zip
*.bak

# ========== 个人配置 ==========
.claude/

# ========== 系统 ==========
.DS_Store

